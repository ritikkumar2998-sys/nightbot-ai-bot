# GEMINI_API_KEY: Required for Gemini AI API calls (Google AI Studio se free me milta hai).
# Users configure this via the Secrets panel in AI Studio UI, ya Render/Railway me add karte hain.
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Server port (default 3000, hosting provider automatically sets this)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
